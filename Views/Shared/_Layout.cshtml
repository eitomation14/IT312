<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Instructor Information System</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header class="site-header">
        <a class="brand" asp-controller="Account" asp-action="Dashboard"><span class="brand-mark">IIS</span><span>Instructor Information System</span></a>
        <nav class="site-nav" aria-label="Main navigation">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-controller="Account" asp-action="Dashboard">Dashboard</a>
                <a asp-controller="Instructor" asp-action="Index">Instructors</a>
                <form asp-controller="Account" asp-action="Logout" method="post"><button class="nav-button" type="submit">Sign out</button></form>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login">Sign in</a>
                <a class="nav-register" asp-controller="Account" asp-action="Register">Register</a>
            }
        </nav>
    </header>
    <main class="content">@RenderBody()</main>
    <footer><p>&copy; @DateTime.UtcNow.Year Instructor Information System</p></footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>