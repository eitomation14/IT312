@model Instructor_Information_System.Models.Instructor
@{ ViewData["Title"] = "Delete Instructor"; }
<section class="page-shell narrow"><div class="form-card danger-card"><p class="eyebrow">REMOVE RECORD</p><h1>Delete instructor?</h1><p>Are you sure you want to permanently delete <strong>@Model.Name</strong> (@Model.Email)?</p><form asp-action="Delete" method="post"><input type="hidden" asp-for="InstructorID" /><div class="form-actions"><a class="button button-secondary" asp-action="Index">Cancel</a><button class="button button-danger" type="submit">Delete instructor</button></div></form></div></section>
