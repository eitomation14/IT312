@model Instructor_Information_System.Models.Instructor
@{ ViewData["Title"] = "Add Instructor"; }
<section class="page-shell narrow"><div class="form-card"><p class="eyebrow">NEW RECORD</p><h1>Add instructor</h1><p class="page-subtitle">Enter the instructor's directory details.</p><form asp-action="Create" method="post" class="auth-form"><div asp-validation-summary="ModelOnly" class="validation-message"></div><label asp-for="InstructorID"></label><input asp-for="InstructorID" type="text" maxlength="7" pattern="[0-9]{2}-[0-9]{4}" placeholder="00-0000" /><span asp-validation-for="InstructorID" class="validation-message"></span><label asp-for="Name"></label><input asp-for="Name" autocomplete="name" /><span asp-validation-for="Name" class="validation-message"></span><label asp-for="Gender"></label><input asp-for="Gender" /><span asp-validation-for="Gender" class="validation-message"></span><label asp-for="Age"></label><input asp-for="Age" type="number" min="18" max="100" /><span asp-validation-for="Age" class="validation-message"></span><label asp-for="Email"></label><input asp-for="Email" type="email" autocomplete="email" /><span asp-validation-for="Email" class="validation-message"></span><label asp-for="Address"></label><input asp-for="Address" autocomplete="street-address" /><span asp-validation-for="Address" class="validation-message"></span><label asp-for="Majorship"></label><input asp-for="Majorship" /><span asp-validation-for="Majorship" class="validation-message"></span><label asp-for="Designation"></label><input asp-for="Designation" /><span asp-validation-for="Designation" class="validation-message"></span><label asp-for="ContactNo"></label><input asp-for="ContactNo" type="tel" autocomplete="tel" /><span asp-validation-for="ContactNo" class="validation-message"></span><label asp-for="BachelorDegree"></label><input asp-for="BachelorDegree" /><span asp-validation-for="BachelorDegree" class="validation-message"></span><div class="form-actions"><a class="button button-secondary" asp-action="Index">Cancel</a><button class="button button-primary" type="submit">Save instructor</button></div></form></div></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
