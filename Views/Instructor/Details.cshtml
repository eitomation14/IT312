@model Instructor_Information_System.Models.Instructor
@{ ViewData["Title"] = "Instructor Details"; }
<section class="page-shell narrow"><div class="form-card"><p class="eyebrow">INSTRUCTOR RECORD</p><h1>@Model.Name</h1><dl class="details-list"><dt>Instructor ID</dt><dd>@Model.InstructorID</dd><dt>Gender</dt><dd>@Model.Gender</dd><dt>Age</dt><dd>@Model.Age</dd><dt>Email</dt><dd>@Model.Email</dd><dt>Address</dt><dd>@Model.Address</dd><dt>Majorship</dt><dd>@Model.Majorship</dd><dt>Designation</dt><dd>@Model.Designation</dd><dt>Contact No.</dt><dd>@Model.ContactNo</dd><dt>Bachelor Degree</dt><dd>@Model.BachelorDegree</dd></dl><div class="form-actions"><a class="button button-secondary" asp-action="Index">Back to list</a><a class="button button-primary" asp-action="Edit" asp-route-id="@Model.InstructorID">Edit</a></div></div></section>
